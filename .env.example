DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mybusi?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=15m

# SMTP is required for email verification and password recovery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyBusi <no-reply@example.com>

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_MOBILE_REDIRECT_URI=mydepot://auth/callback

CORS_ORIGIN=http://localhost:3000,http://localhost:5173
