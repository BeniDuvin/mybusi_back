generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERANT
  CAISSIER
  CLIENT
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum MobileMoneyProvider {
  ORANGE_MONEY
  MTN_MONEY
  MOOV_MONEY
  WAVE
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  password      String?
  googleId      String?  @unique
  firstName     String
  lastName      String
  role          Role     @default(CLIENT)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  refreshToken  String?
  otpCode       String?
  otpExpiry     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  depots        UserDepot[]
  sales         Sale[]
  purchases     Purchase[]
  expenses      Expense[]
  otherIncomes  OtherIncome[]
  salaryPayments SalaryPayment[]
  logs          Log[]

  @@index([email])
  @@index([phone])
}

model Depot {
  id          String   @id @default(uuid())
  name        String
  address     String
  phone       String
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserDepot[]
  products    Product[]
  stocks      Stock[]
  sales       Sale[]
  purchases   Purchase[]
  expenses    Expense[]
  otherIncomes OtherIncome[]
  logs        Log[]

  @@index([name])
}

model UserDepot {
  id        String   @id @default(uuid())
  userId    String
  depotId   String
  assignedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  depot     Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@unique([userId, depotId])
  @@index([userId])
  @@index([depotId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String?
  barcode       String?  @unique
  sku           String?  @unique
  categoryId    String
  brandId       String?
  depotId       String
  purchasePrice Float
  sellingPrice  Float
  minStock      Int      @default(10)
  isActive      Boolean  @default(true)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id])
  brand         Brand?   @relation(fields: [brandId], references: [id])
  depot         Depot    @relation(fields: [depotId], references: [id])
  stocks        Stock[]
  saleLines     SaleLine[]
  purchaseLines PurchaseLine[]

  @@index([name])
  @@index([barcode])
  @@index([categoryId])
  @@index([depotId])
}

model Stock {
  id          String   @id @default(uuid())
  productId   String
  depotId     String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  depot       Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  movements   StockMovement[]

  @@unique([productId, depotId])
  @@index([productId])
  @@index([depotId])
}

model StockMovement {
  id          String            @id @default(uuid())
  stockId     String
  type        StockMovementType
  quantity    Int
  reason      String?
  reference   String?
  createdAt   DateTime          @default(now())

  stock       Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([createdAt])
}

model Client {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String   @unique
  email       String?  @unique
  address     String?
  isActive    Boolean  @default(true)
  totalDebt   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       Sale[]
  payments    Payment[]

  @@index([phone])
  @@index([email])
}

model Sale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique
  depotId       String
  userId        String
  clientId      String?
  totalAmount   Float
  paidAmount    Float         @default(0)
  remainingAmount Float       @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  status        PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  depot         Depot         @relation(fields: [depotId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  client        Client?       @relation(fields: [clientId], references: [id])
  lines         SaleLine[]
  payments      Payment[]

  @@index([saleNumber])
  @@index([depotId])
  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

model SaleLine {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  discount    Float    @default(0)

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id                String              @id @default(uuid())
  saleId            String?
  clientId          String?
  amount            Float
  method            PaymentMethod
  status            PaymentStatus       @default(PENDING)
  mobileMoneyProvider MobileMoneyProvider?
  mobileMoneyNumber String?
  transactionId     String?
  reference         String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sale              Sale?               @relation(fields: [saleId], references: [id])
  client            Client?             @relation(fields: [clientId], references: [id])

  @@index([saleId])
  @@index([clientId])
  @@index([transactionId])
  @@index([createdAt])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String?  @unique
  address     String?
  isActive    Boolean  @default(true)
  totalDebt   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   Purchase[]

  @@index([phone])
  @@index([email])
}

model Purchase {
  id              String        @id @default(uuid())
  purchaseNumber  String        @unique
  depotId         String
  userId          String
  supplierId      String
  totalAmount     Float
  paidAmount      Float         @default(0)
  remainingAmount Float         @default(0)
  status          PaymentStatus @default(PENDING)
  notes           String?
  deliveryDate    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  depot           Depot         @relation(fields: [depotId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  lines           PurchaseLine[]

  @@index([purchaseNumber])
  @@index([depotId])
  @@index([userId])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseLine {
  id          String   @id @default(uuid())
  purchaseId  String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model Expense {
  id          String          @id @default(uuid())
  depotId     String
  userId      String
  category    String
  amount      Float
  description String
  reference   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  depot       Depot           @relation(fields: [depotId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([depotId])
  @@index([userId])
  @@index([createdAt])
}

model OtherIncome {
  id          String   @id @default(uuid())
  depotId     String
  userId      String
  category    String
  amount      Float
  description String
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  depot       Depot    @relation(fields: [depotId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([depotId])
  @@index([userId])
  @@index([createdAt])
}

model SalaryPayment {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  period      String
  paymentDate DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paymentDate])
}

model FinancialTransaction {
  id          String          @id @default(uuid())
  type        TransactionType
  category    String
  amount      Float
  description String
  reference   String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type])
  @@index([date])
}

model Log {
  id          String   @id @default(uuid())
  userId      String?
  depotId     String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  depot       Depot?   @relation(fields: [depotId], references: [id])

  @@index([userId])
  @@index([depotId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceNumber String @unique
  saleId      String?
  type        String
  format      String
  content     String
  createdAt   DateTime @default(now())

  @@index([invoiceNumber])
  @@index([saleId])
}
